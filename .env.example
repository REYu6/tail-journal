# Copy to .env for the local launcher. The defaults work without API keys.
PET_PUBLIC_URL=http://127.0.0.1:8000
PET_IMAGE_MODE=demo
PET_MODEL_MODE=demo
PET_PAYMENT_MODE=demo

# For cloud inference set the corresponding mode above to live.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
QWEN_IMAGE_MODEL=qwen-image-2.1-turbo
FAL_KEY=

# For actual payments set PET_PAYMENT_MODE=stripe and a public HTTPS URL.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional PostgreSQL DSN. Leave empty for SQLite in PET_DATA_DIR.
DATABASE_URL=
# Optional private S3-compatible storage. Leave empty for local media.
PET_S3_BUCKET=
PET_S3_REGION=
PET_S3_ENDPOINT=
